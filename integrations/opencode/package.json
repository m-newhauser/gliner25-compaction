{
  "name": "opencode-gliner-prune",
  "version": "0.1.2",
  "description": "Local GLiNER2.5 context pruning for OpenCode",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mary Newhauser",
  "keywords": [
    "opencode",
    "gliner",
    "context-pruning",
    "local-ai",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-newhauser/gliner25-compaction.git",
    "directory": "integrations/opencode"
  },
  "homepage": "https://github.com/m-newhauser/gliner25-compaction#readme",
  "bugs": {
    "url": "https://github.com/m-newhauser/gliner25-compaction/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "engines": {
    "opencode": ">=1.18.31 <1.19.0"
  },
  "scripts": {
    "build": "tsup src/server.ts src/tui.ts --format esm --dts --clean --out-dir dist && node scripts/prepare-runtime.mjs",
    "prepack": "npm run build"
  }
}
