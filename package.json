{
  "name": "gliner25-context-pruning",
  "private": true,
  "type": "module",
  "workspaces": [
    "integrations/opencode"
  ],
  "scripts": {
    "build": "npm run build -w opencode-gliner-prune",
    "check": "npm run typecheck && npm run test:integrations && npm run build",
    "typecheck": "tsc -p integrations/opencode/tsconfig.json && tsc -p integrations/claude-code/tsconfig.json",
    "test:opencode": "tsx --test integrations/opencode/test/**/*.test.ts",
    "test:claude": "tsx --test integrations/claude-code/test/**/*.test.ts",
    "test:integrations": "npm run test:opencode && npm run test:claude",
    "test:release:opencode": "node scripts/verify_opencode_release.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
